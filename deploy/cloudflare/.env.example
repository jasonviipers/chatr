# Copy to .env next to docker-compose.yml.
# Where the web app is (the Cloudflare Pages custom domain). Only this origin may talk to the API.
APP_HOST=chat.example.com
# Signs the session tokens. Generate one:  node -p "require('crypto').randomBytes(48).toString('base64url')"
AUTH_SECRET=
# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > the token in the install command.
TUNNEL_TOKEN=
