# Copy to .env next to docker-compose.yml.
# Where the web app is (the address the web app has on Cloudflare). Only this origin may talk to the API.
APP_HOST=chat.example.com
# The address of this API (a sibling name such as chat-api.example.com).
API_HOST=chat-api.example.com
# Signs the session tokens. Generate one:  head -c 48 /dev/urandom | base64 | tr -d '=+/\n'
AUTH_SECRET=
# Only for --profile tunnel: the token from Zero Trust > Networks > Tunnels > your tunnel (the string after --token).
TUNNEL_TOKEN=
