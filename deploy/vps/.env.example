# Copy to .env next to docker-compose.yml.
# Your domain name (already pointing at this server).
DOMAIN=chat.example.com
# Shown in the title and the footer.
APP_NAME=Chatr
# Signs the session tokens. Generate one:  node -p "require('crypto').randomBytes(48).toString('base64url')"
AUTH_SECRET=
# Optional relay from Cloudflare, with nothing to run (dashboard > Realtime > TURN Server > create a key). Both or neither.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Or a relay of your own (see the coturn service):
# TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# TURN_SECRET=
