# --- Network -----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# `auto` (default): plain HTTP in development; in production HTTPS when ssl/key.pem and
# ssl/cert.pem exist, plain HTTP otherwise (behind nginx/another TLS-terminating proxy, see nginx.conf).
# `on` forces HTTPS everywhere (to try the self-signed certificate locally), `off` forces HTTP.
# Production = NODE_ENV=production, which `bun run start` and the Docker image set.
TLS=auto
# Only set to true when a reverse proxy you control sets X-Forwarded-For
TRUST_PROXY=false

# --- Web app -----------------------------------------------------------------
# host[:port] of the web app, used as an exact CORS / WebSocket origin
WEB_APP_HOST=example.com
# extra exact origins, comma separated
ALLOWED_ORIGINS=

# --- Security ----------------------------------------------------------------
# Signs session tokens. REQUIRED in production, at least 32 characters. Generate one with:
#   node -p "require('crypto').randomBytes(48).toString('base64url')"
AUTH_SECRET=

# --- Database ----------------------------------------------------------------
DATABASE_PATH=./data/chatr.sqlite

# --- Calls on bad networks ---------------------------------------------------
# STUN finds the public address; TURN relays media when a direct path is impossible
# (mobile carriers, strict NATs, corporate firewalls). Run coturn (see ../.docker-compose.yml)
# with `use-auth-secret` and `static-auth-secret=<TURN_SECRET>`.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600

# Or a relay from Cloudflare Realtime TURN, with nothing to run (dashboard > Realtime > TURN Server > create a key).
# Set both or neither; the token stays on this server. They can be used together with coturn.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# 600 to 172800; it must be longer than your longest meeting
CLOUDFLARE_TURN_TTL_SECONDS=86400

# --- Capacity ----------------------------------------------------------------
MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=60
