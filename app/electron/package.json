{
  "name": "chatr",
  "version": "1.0.0",
  "description": "An Amazing Capacitor App",
  "author": {
    "name": "Jason Michel",
    "email": "jason@viipers.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonviipers/chatr.git",
    "directory": "app/electron"
  },
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.4",
  "main": "build/src/index.js",
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc && electron-rebuild",
    "test": "node --test src/csp.test.ts",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "bun run build && electron --inspect=5858 ./",
    "electron:pack": "bun run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "bun run build && electron-builder build -c ./electron-builder.config.json -p always"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "chokidar": "^6.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-serve": "^3.0.1",
    "electron-unhandled": "^6.0.0",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "trustedDependencies": []
}
