{
  "compileOnSave": true,
  "include": [
    "./src/**/*",
    "./capacitor.config.ts",
    "./capacitor.config.js"
  ],
  "compilerOptions": {
    "outDir": "./build",
    "importHelpers": true,
    "target": "ES2022",
    "module": "node20",
    "esModuleInterop": true,
    "strict": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "rootDir": "."
  },
  "exclude": [
    "./src/**/*.test.ts"
  ]
}
