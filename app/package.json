{
  "name": "chatr",
  "version": "0.1.17",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"{src,apps}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" ",
    "start": "electron-forge start",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "serve": "ionic serve --https",
    "android:build": "ionic capacitor build android --prod",
    "ios:build": "ionic capacitor build ios --prod",
    "desktop:serve": "bun run build && bun run desktop:build && cd electron && bun run electron:start",
    "desktop:build": "cap sync @capacitor-community/electron",
    "desktop:build:mac": "cd electron && bun run electron:build:mac",
    "desktop:build:windows": "cd electron && bun run electron:build:windows",
    "desktop:build:linux": "cd electron && bun run electron:build:linux"
  },
  "dependencies": {
    "@awesome-cordova-plugins/core": "^9.7.0",
    "@awesome-cordova-plugins/social-sharing": "^9.7.0",
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/core": "^9.0.9",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/react": "^9.0.9",
    "@ionic/react-router": "^9.0.9",
    "@redux-devtools/extension": "^4.0.0",
    "axios": "^1.20.0",
    "copy-to-clipboard": "^4.0.2",
    "cordova-plugin-x-socialsharing": "^6.0.4",
    "electron-squirrel-startup": "^1.0.1",
    "es6-promise-plugin": "^4.2.2",
    "fabric": "^7.4.0",
    "howler": "^2.2.4",
    "ionicons": "^8.1.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "nanoid": "^6.0.2",
    "peerjs": "^1.5.5",
    "prop-types": "^15.8.1",
    "qs": "^6.16.1",
    "quill": "^2.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "redux": "^5.0.1",
    "rxjs": "^7.8.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@ionic/cli": "^7.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/howler": "^2.2.13",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.0.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "trustedDependencies": []
}
